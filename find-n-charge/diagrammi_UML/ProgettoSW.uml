              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_fZiMo894EfCvI50SpPRHVQ" name="verifica" specification="_fZg-gc94EfCvI50SpPRHVQ">
                <language>JAVA</language>
                <body>CompletableFuture&lt;Boolean> future = new CompletableFuture&lt;>();
firebasePrenotazioniService.cercaPrenotazione(c, data, orario).thenAccept( ris -> {
    if (ris != null) {
        future.complete(false);
    } else
        future.complete(true);
}).exceptionally( ex -> {
    future.complete(false);
    return null;
});
return future;</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_fZko4M94EfCvI50SpPRHVQ" name="prenota" specification="_fZizsM94EfCvI50SpPRHVQ">
                <language>JAVA</language>
                <body>CompletableFuture&lt;Boolean> future = new CompletableFuture&lt;>();
if (c.getStato().equals(&quot;Manutenzione&quot;)) {
    future.complete(false);
    return future;
}
verifica(c, data, orario).thenAccept( ris -> {
    if (!ris) {
        future.complete(false);
        return;
    }
    Prenotazione p = new Prenotazione(generaId(), c.getId(), u.getUsername(), data, orario, LocalDate.now().toString(), auto);
    firebasePrenotazioniService.salvaPrenotazione(p).thenRun(() -> future.complete(true)).exceptionally( ex -> {
        future.complete(false);
        return null;
    });
}).exceptionally(// eccezioni di verifica(c, data, orario)
 ex -> {
    future.complete(false);
    return null;
});
return future;</body>
              </ownedBehavior>
