              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_fWJhcM94EfCvI50SpPRHVQ" name="FirebaseAutoService" specification="_fWHFMM94EfCvI50SpPRHVQ">
                <language>JAVA</language>
