          </defaultValue>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_fSja4M94EfCvI50SpPRHVQ" name="titleDisplay" visibility="private" type="_fSaQ8M94EfCvI50SpPRHVQ" isUnique="false">
          <defaultValue xmi:type="uml:OpaqueExpression" xmi:id="_fSkpAM94EfCvI50SpPRHVQ" name="defaultValue">
