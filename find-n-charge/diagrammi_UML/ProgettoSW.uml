        <generalization xmi:type="uml:Generalization" xmi:id="_fSUKUM94EfCvI50SpPRHVQ" general="_fNk0Qc94EfCvI50SpPRHVQ"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_fSX0sM94EfCvI50SpPRHVQ" name="numberDisplay" visibility="private" type="_fSVYcM94EfCvI50SpPRHVQ" isUnique="false">
          <defaultValue xmi:type="uml:OpaqueExpression" xmi:id="_fSX0sc94EfCvI50SpPRHVQ" name="defaultValue">
