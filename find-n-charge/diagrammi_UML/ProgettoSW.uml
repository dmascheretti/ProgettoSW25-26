      <packagedElement xmi:type="uml:Class" xmi:id="_fRiHMM94EfCvI50SpPRHVQ" name="AdminPrenotazioniView" visibility="public">
        <generalization xmi:type="uml:Generalization" xmi:id="_fRjVUM94EfCvI50SpPRHVQ" general="_fNk0Qc94EfCvI50SpPRHVQ"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_fRjVUc94EfCvI50SpPRHVQ" name="prenoGrid" visibility="private" type="_fQj20M94EfCvI50SpPRHVQ" isUnique="false">
          <defaultValue xmi:type="uml:OpaqueExpression" xmi:id="_fRj8YM94EfCvI50SpPRHVQ" name="defaultValue">
