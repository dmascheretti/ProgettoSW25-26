              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_fTbko894EfCvI50SpPRHVQ" name="aggiornaOrari" specification="_fTa9kM94EfCvI50SpPRHVQ">
                <language>JAVA</language>
                <body>if (!isVisible() || getParent() == null)
    return;
bookingTimeSlot.clear();
//Generazione di tutti i time slots
List&lt;String> slots = generateTimeSlots(date);
//Toglie quelli occupati
if (orariOccupati != null &amp;&amp; !orariOccupati.isEmpty()) {
    slots.removeAll(orariOccupati);
}
// Aggiorna i campi
bookingTimeSlot.setItems(slots);
bookingTimeSlot.setEnabled(!slots.isEmpty());</body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_fTeA4M94EfCvI50SpPRHVQ" name="generateTimeSlots" specification="_fTcLsM94EfCvI50SpPRHVQ">
                <language>JAVA</language>
                <body>List&lt;String> slots = new ArrayList&lt;>();
// Orario di partenza
LocalTime time;
LocalDate oggi = LocalDate.now(ZoneId.of(&quot;Europe/Rome&quot;));
// da mezzanotte
if (date.equals(oggi)) {
    LocalTime now = LocalTime.now(ZoneId.of(&quot;Europe/Rome&quot;));
    if (now.getMinute() &lt; 30) {
        time = now.withMinute(30).withSecond(0).withNano(0);
    } else {
        time = now.plusHours(1).withMinute(0).withSecond(0).withNano(0);
    }
    if (// Se siamo nell'ultima mezz'ora del giorno (dopo le 23.40), allora
    time.equals(LocalTime.MIDNIGHT)) {
        // la lista di slot è vuota per oggi
        return slots;
    }
} else {
    time = LocalTime.MIDNIGHT;
}
// Generazione slots fino al giorno successivo in formato &quot;HH:mm&quot;
DateTimeFormatter formatter = DateTimeFormatter.ofPattern(&quot;HH:mm&quot;);
while (true) {
    slots.add(time.format(formatter));
    LocalTime nextTime = time.plusMinutes(30);
    if (nextTime.equals(LocalTime.MIDNIGHT))
        break;
    time = nextTime;
}
return slots;</body>
              </ownedBehavior>
