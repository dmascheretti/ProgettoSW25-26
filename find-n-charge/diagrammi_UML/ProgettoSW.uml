          <ownedParameter xmi:type="uml:Parameter" xmi:id="_fRpb8s94EfCvI50SpPRHVQ" type="_fMCjMc94EfCvI50SpPRHVQ" direction="return"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_fRqDAM94EfCvI50SpPRHVQ" name="prenotazione" type="_fRpb8M94EfCvI50SpPRHVQ"/>
